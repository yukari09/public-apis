---
import '../styles/global.css';
import { CONTACT_EMAIL, GITHUB_URL, SITE_URL } from '../lib/data.js';

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  jsonLd = null,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).href;
const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: '全部 API' },
  { href: '/about/', label: '关于' },
  { href: '/disclaimer/', label: '免责' },
  { href: '/privacy/', label: '隐私' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0b0e14" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="免费 API 中文索引" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23101c14'/%3E%3Cpath d='M10 10l6 6-6 6M18 22h5' fill='none' stroke='%237ee787' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8834563225975418"
      crossorigin="anonymous"
    ></script>
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">辞</span>
          <span>免费 API 中文索引</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={
                item.href === '/'
                  ? path === '/'
                    ? 'page'
                    : undefined
                  : path.startsWith(item.href)
                    ? 'page'
                    : undefined
              }
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="page-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <div class="footer-links">
            <a href="/about/">关于</a>
            <a href="/about/#sources">数据来源</a>
            <a href="/disclaimer/">免责声明</a>
            <a href="/privacy/">隐私说明</a>
            <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </div>
          <p class="footer-meta">
            数据 CC BY 4.0，代码 MIT。API 名称与商标归各自所有者；本站只做索引，不代理请求。
          </p>
        </div>
        <div>© {year} Kari · 每 14 天更新实测状态</div>
      </div>
    </footer>
  </body>
</html>
