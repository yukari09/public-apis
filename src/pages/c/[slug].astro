---
import Base from '../../layouts/Base.astro';
import ApiRow from '../../components/ApiRow.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import {
  adjacentCategories,
  categories,
  categoryApis,
  categoryCode,
  categoryColor,
  categoryIntro,
} from '../../lib/data.js';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      items: categoryApis(category.slug),
    },
  }));
}

const { category, items } = Astro.props;
const intro = categoryIntro(category, items);
const title = `${category.name} API 免费接口（${items.length} 个）· 免费 API 中文索引`;
const adjacent = adjacentCategories(category.slug);
---

<Base
  title={title}
  description={intro}
  canonicalPath={`/c/${category.slug}/`}
>
  <div class="container category-shell">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: category.name, href: `/c/${category.slug}/` },
      ]}
    />

    <header class="category-header">
      <h1 class="category-title" style={`--cat:${categoryColor(category.slug)}`}>
        <span class="category-code">{categoryCode(category.slug)}</span>
        {category.name} API
      </h1>
      <p class="category-intro">{intro}</p>
    </header>

    <div class="result-line">
      <span>共 <strong>{items.length}</strong> 条词条</span>
      <a class="category-page-link" href="/">返回全部 API →</a>
    </div>

    <div class="entry-head" aria-hidden="true">
      <span>词条</span>
      <span>免费额度 / 认证</span>
      <span>状态</span>
    </div>

    <ul class="entry-list">
      {items.map((api) => <ApiRow api={api} />)}
    </ul>

    <nav class="category-adjacent" aria-label="相邻分类">
      {adjacent.map((item) => (
        <a href={`/c/${item.slug}/`}>
          <span class="adj-code">{categoryCode(item.slug)}</span>
          {item.name}
        </a>
      ))}
    </nav>
  </div>
</Base>
