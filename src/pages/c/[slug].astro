---
import Base from '../../layouts/Base.astro';
import ApiRow from '../../components/ApiRow.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import {
  adjacentCategories,
  categories,
  categoryApis,
  categoryCode,
  categoryIntro,
} from '../../lib/data.js';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      items: categoryApis(category.slug),
    },
  }));
}

const { category, items } = Astro.props;
const intro = categoryIntro(category, items);
const title = `${category.name} API 免费接口（${items.length} 个）· 免费 API 中文索引`;
const adjacent = adjacentCategories(category.slug);
---

<Base
  title={title}
  description={intro}
  canonicalPath={`/c/${category.slug}/`}
>
  <div class="shell category-shell">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: category.name, href: `/c/${category.slug}/` },
      ]}
    />

    <header class="category-header">
      <h1 class="category-title">
        <span class="category-code">{categoryCode(category.slug)}</span>
        {category.name} API
      </h1>
      <p class="category-intro">{intro}</p>
    </header>

    <div class="result-line">
      <span id="category-count">共 <strong>{items.length}</strong> 条词条</span>
      <a class="category-page-link" href="/">返回全部 API →</a>
    </div>

    <ul class="entry-list" id="api-list">
      {items.map((api) => <ApiRow api={api} />)}
    </ul>

    <nav class="pagination" id="pagination" aria-label="分类分页" hidden></nav>

    <nav class="category-adjacent" aria-label="相邻分类">
      {adjacent.map((item) => (
        <a href={`/c/${item.slug}/`}>
          <span class="adj-code">{categoryCode(item.slug)}</span>
          {item.name}
        </a>
      ))}
    </nav>
  </div>

  <script is:inline>
    (() => {
      'use strict';

      const PAGE_SIZE = 20;
      const list = document.getElementById('api-list');
      if (!list) return;
      const rows = Array.from(list.querySelectorAll('.entry'));
      const pagination = document.getElementById('pagination');
      const count = document.getElementById('category-count');
      if (rows.length === 0) return;

      const parsePage = () => {
        const value = Number.parseInt(new URLSearchParams(location.search).get('page') || '1', 10);
        return Number.isFinite(value) && value > 0 ? value : 1;
      };
      let page = parsePage();

      function sequence(current, total) {
        if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
        const pages = [1];
        const start = Math.max(2, current - 1);
        const end = Math.min(total - 1, current + 1);
        if (start > 2) pages.push('...');
        for (let item = start; item <= end; item += 1) pages.push(item);
        if (end < total - 1) pages.push('...');
        pages.push(total);
        return pages;
      }

      function control(label, target, current, disabled) {
        const passive = current || disabled;
        const element = document.createElement(passive ? 'span' : 'a');
        element.className = `page-btn${current ? ' is-current' : ''}${disabled ? ' is-disabled' : ''}`;
        element.textContent = label;
        if (current) element.setAttribute('aria-current', 'page');
        if (disabled) element.setAttribute('aria-disabled', 'true');
        if (!passive) {
          element.href = `${location.pathname}?page=${target}`;
          element.dataset.page = String(target);
        }
        return element;
      }

      function render() {
        const totalPages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
        page = Math.min(Math.max(1, page), totalPages);
        const start = (page - 1) * PAGE_SIZE;
        const visible = rows.slice(start, start + PAGE_SIZE);
        const visibleSet = new Set(visible);
        rows.forEach((row) => row.classList.toggle('is-hidden', !visibleSet.has(row)));
        count.textContent = `共 ${rows.length} 条 · 第 ${start + 1}–${start + visible.length} 条`;
        pagination.hidden = totalPages <= 1;
        pagination.innerHTML = '';
        pagination.append(control('上一页', page - 1, false, page === 1));
        for (const item of sequence(page, totalPages)) {
          if (item === '...') {
            const gap = document.createElement('span');
            gap.className = 'page-gap';
            gap.textContent = '…';
            pagination.append(gap);
          } else {
            pagination.append(control(String(item), item, item === page, false));
          }
        }
        pagination.append(control('下一页', page + 1, false, page === totalPages));
      }

      pagination.addEventListener('click', (event) => {
        const link = event.target.closest('a[data-page]');
        if (!link) return;
        event.preventDefault();
        page = Number(link.dataset.page);
        render();
        history.pushState({ page }, '', `${location.pathname}?page=${page}`);
        list.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      window.addEventListener('popstate', () => {
        page = parsePage();
        render();
      });

      render();
    })();
  </script>
</Base>
