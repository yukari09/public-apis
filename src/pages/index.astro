---
import Base from '../layouts/Base.astro';
import ApiRow from '../components/ApiRow.astro';
import AdSlot from '../components/AdSlot.astro';
import {
  apis,
  categories,
  categoryCode,
  popularCategories,
  SITE_URL,
  stats,
} from '../lib/data.js';

const title = '免费 API 中文索引 · 244 个可直接调用的公共接口';
const description =
  '给中文开发者的免费 API 目录：244 个公共接口，带中文说明、免费额度、认证方式、实测状态和可直接复制的 curl 示例。';
const hotCategories = popularCategories(3);
const spotlight =
  apis.find((api) => api.slug === 'wttr-in') ??
  apis.find((api) => api.featured && api.auth === 'none' && api.status === 'ok') ??
  apis.find((api) => api.auth === 'none') ??
  apis[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '免费 API 中文索引',
  numberOfItems: 30,
  itemListElement: apis.slice(0, 30).map((api, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: api.name,
    url: `${SITE_URL}/a/${api.slug}/`,
  })),
};
---

<Base title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <div class="shell">
    <section class="masthead" aria-labelledby="page-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 class="hero-title" id="page-title">
            免费 API 中文索引<span class="hero-mark" aria-hidden="true"></span>
          </h1>
          <p class="lede">
            给中文开发者的免费 API 目录。中文说明、免费额度、认证方式、实测状态和可直接复制的 curl 示例，都在一条词条里。
          </p>
          <div class="status-rail" aria-label="数据概览">
            <span class="status-item"><strong>{stats.total}</strong> 收录</span>
            <span class="status-item"><strong>{stats.ok}</strong> 可直调</span>
            <span class="status-item"><strong>{stats.keyRequired}</strong> 需 Key</span>
            <span class="status-item"><strong>{stats.categories}</strong> 分类</span>
            <span class="status-item is-live"><i></i>{stats.lastChecked} 实测</span>
          </div>
        </div>

        <aside class="sample-panel" aria-label="示例调用">
          <div class="sample-head">
            <span class="cat-dot"></span>
            <span class="sample-name">{spotlight.name}</span>
            <span class="sample-kicker">SAMPLE CALL</span>
          </div>
          <pre class="sample-code"><code>{spotlight.example}</code></pre>
          <div class="sample-foot">
            <span>{spotlight.free_tier}</span>
            <a href={`/a/${spotlight.slug}/`}>查看词条</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="search-deck" aria-label="搜索和筛选">
      <label class="search-field">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span class="visually-hidden">搜索 API</span>
        <input
          id="api-search"
          type="search"
          placeholder="搜索 API、说明或分类"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <div class="filters" role="group" aria-label="筛选 API">
        <button class="filter-btn" type="button" data-auth="all" aria-pressed="true">全部</button>
        <button class="filter-btn" type="button" data-auth="none" aria-pressed="false">无需认证</button>
        <button class="filter-btn" type="button" data-auth="key" aria-pressed="false">需要 Key</button>
        <button class="filter-btn" type="button" id="quota-filter" aria-pressed="false">有额度</button>
      </div>
      <button class="export-btn" type="button" id="export-csv">导出 CSV</button>
    </section>

    <div class="index-layout">
      <aside class="index-rail" aria-labelledby="category-title">
        <h2 class="rail-label" id="category-title">分类</h2>
        <nav aria-label="API 分类">
          <ul class="cat-list">
            <li>
              <a
                class="cat-link is-active"
                href="/"
                data-cat="all"
                data-name="全部"
              >
                <span class="cat-dot"></span>
                <span class="cat-code">00</span>
                <span class="cat-name">全部</span>
                <span class="cat-count">{apis.length}</span>
              </a>
            </li>
            {categories.map((category) => (
              <li>
                <a
                  class="cat-link"
                  href={`/c/${category.slug}/`}
                  data-cat={category.slug}
                  data-name={category.name}
                >
                  <span class="cat-dot"></span>
                  <span class="cat-code">{categoryCode(category.slug)}</span>
                  <span class="cat-name">{category.name}</span>
                  <span class="cat-count">{category.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <section class="content-column" aria-labelledby="list-title">
        <h2 class="visually-hidden" id="list-title">API 列表</h2>

        <div class="result-line">
          <span id="result-count" aria-live="polite">共 {apis.length} 条</span>
          <span id="active-category" hidden></span>
        </div>

        <ul class="entry-list" id="api-list">
          {apis.map((api, index) => (
            <>
              <ApiRow api={api} />
              {index === 7 && (
                <li class="ad-item" id="list-ad">
                  <AdSlot placement="list" />
                </li>
              )}
            </>
          ))}
        </ul>

        <div class="empty-state" id="empty-state" hidden>
          <h2>没有匹配的 API</h2>
          <p id="empty-detail">换个关键词，或从这些分类继续：</p>
          <button class="empty-reset" type="button" id="empty-reset" hidden></button>
          <div class="popular-chips">
            {hotCategories.map((category) => (
              <a href={`/c/${category.slug}/`}>{category.name}</a>
            ))}
          </div>
        </div>

        <nav class="pagination" id="pagination" aria-label="API 分页" hidden></nav>
      </section>
    </div>
  </div>

  <script is:inline>
    (() => {
      'use strict';

      const PAGE_SIZE = 20;
      const list = document.getElementById('api-list');
      const rows = Array.from(list.querySelectorAll('.entry'));
      const adItem = document.getElementById('list-ad');
      const searchInput = document.getElementById('api-search');
      const authButtons = Array.from(document.querySelectorAll('.filter-btn[data-auth]'));
      const quotaButton = document.getElementById('quota-filter');
      const catLinks = Array.from(document.querySelectorAll('.cat-link'));
      const resultCount = document.getElementById('result-count');
      const activeCategory = document.getElementById('active-category');
      const emptyState = document.getElementById('empty-state');
      const emptyDetail = document.getElementById('empty-detail');
      const emptyReset = document.getElementById('empty-reset');
      const pagination = document.getElementById('pagination');
      const exportButton = document.getElementById('export-csv');
      const validCats = new Set(catLinks.map((link) => link.dataset.cat));
      const categoryNames = Object.fromEntries(
        catLinks.map((link) => [link.dataset.cat, link.dataset.name]),
      );
      const haystacks = new WeakMap();
      const siteUrl = 'https://public-apis.morio.cc';

      const state = { q: '', auth: 'all', lim: false, cat: 'all', page: 1 };
      let matches = [];

      function readStateFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const page = Number.parseInt(params.get('page') || '1', 10);
        state.q = params.get('q') || '';
        state.auth = ['all', 'none', 'key'].includes(params.get('auth')) ? params.get('auth') : 'all';
        state.lim = params.get('lim') === '1';
        state.cat = validCats.has(params.get('cat')) ? params.get('cat') : 'all';
        state.page = Number.isFinite(page) && page > 0 ? page : 1;
        searchInput.value = state.q;
      }

      function rowMatches(row) {
        if (state.cat !== 'all' && row.dataset.cat !== state.cat) return false;
        if (state.auth === 'none' && row.dataset.auth !== 'none') return false;
        if (state.auth === 'key' && row.dataset.auth === 'none') return false;
        if (state.lim) {
          const free = freeTier(row);
          if (!/\d/.test(free) || free.startsWith('按量付费')) return false;
        }

        if (!state.q.trim()) return true;
        if (!haystacks.has(row)) {
          haystacks.set(
            row,
            `${row.textContent} ${row.dataset.cat} ${categoryNames[row.dataset.cat] || ''} ${row.dataset.k || ''}`.toLowerCase(),
          );
        }
        const tokens = state.q.toLowerCase().split(/\s+/).filter(Boolean);
        return tokens.every((token) => haystacks.get(row).includes(token));
      }

      function buildQuery(page = state.page) {
        const next = new URLSearchParams();
        if (state.q.trim()) next.set('q', state.q.trim());
        if (state.cat !== 'all') next.set('cat', state.cat);
        if (state.auth !== 'all') next.set('auth', state.auth);
        if (state.lim) next.set('lim', '1');
        if (page > 1) next.set('page', String(page));
        return next.toString();
      }

      function syncUrl(push = false) {
        const query = buildQuery(state.page);
        const url = query ? `/?${query}` : '/';
        if (push) window.history.pushState({ page: state.page }, '', url);
        else window.history.replaceState(null, '', url);
      }

      function pageSequence(current, total) {
        if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
        const pages = [1];
        const start = Math.max(2, current - 1);
        const end = Math.min(total - 1, current + 1);
        if (start > 2) pages.push('...');
        for (let page = start; page <= end; page += 1) pages.push(page);
        if (end < total - 1) pages.push('...');
        pages.push(total);
        return pages;
      }

      function makePageControl(label, page, current, disabled) {
        const passive = current || disabled;
        const element = document.createElement(passive ? 'span' : 'a');
        element.className = `page-btn${current ? ' is-current' : ''}${disabled ? ' is-disabled' : ''}`;
        element.textContent = label;
        if (current) element.setAttribute('aria-current', 'page');
        if (disabled) element.setAttribute('aria-disabled', 'true');
        if (!passive) {
          element.href = `/?${buildQuery(page)}`;
          element.dataset.page = String(page);
        }
        return element;
      }

      function renderPagination(totalPages) {
        pagination.innerHTML = '';
        pagination.append(makePageControl('上一页', state.page - 1, false, state.page === 1));
        for (const item of pageSequence(state.page, totalPages)) {
          if (item === '...') {
            const gap = document.createElement('span');
            gap.className = 'page-gap';
            gap.textContent = '…';
            pagination.append(gap);
          } else {
            pagination.append(makePageControl(String(item), item, item === state.page, false));
          }
        }
        pagination.append(
          makePageControl('下一页', state.page + 1, false, state.page === totalPages),
        );
      }

      function render() {
        matches = rows.filter(rowMatches);
        const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
        state.page = Math.min(Math.max(1, state.page), totalPages);
        const start = (state.page - 1) * PAGE_SIZE;
        const visible = matches.slice(start, start + PAGE_SIZE);
        const visibleSet = new Set(visible);

        rows.forEach((row) => {
          row.classList.toggle('is-hidden', !visibleSet.has(row));
        });

        const showAd = visible.length > 8;
        adItem.classList.toggle('is-hidden', !showAd);
        if (showAd) visible[7].after(adItem);

        const shownStart = matches.length === 0 ? 0 : start + 1;
        const shownEnd = start + visible.length;
        resultCount.textContent =
          matches.length === 0
            ? '共 0 条'
            : `共 ${matches.length} 条 · 第 ${shownStart}–${shownEnd} 条`;
        emptyState.hidden = matches.length !== 0;
        const query = state.q.trim();
        const currentName = categoryNames[state.cat] || '全部';
        const hasFilters = Boolean(query) || state.cat !== 'all' || state.auth !== 'all' || state.lim;
        emptyReset.hidden = !hasFilters;
        const onlyCategory = state.cat !== 'all' && state.auth === 'all' && !state.lim;
        if (query && onlyCategory) {
          emptyDetail.textContent = `当前限定在「${currentName}」分类，没有匹配「${query}」的 API。`;
          emptyReset.textContent = `在全部 API 中搜索「${query}」`;
        } else if (query) {
          emptyDetail.textContent = `没有匹配「${query}」的 API。换个关键词试试。`;
          emptyReset.textContent = '清除搜索和筛选';
        } else if (onlyCategory) {
          emptyDetail.textContent = `「${currentName}」分类下没有符合当前筛选条件的 API。`;
          emptyReset.textContent = '在全部 API 中查看';
        } else if (state.auth !== 'all' || state.lim) {
          emptyDetail.textContent = '当前筛选条件下没有 API。';
          emptyReset.textContent = '清除筛选';
        } else {
          emptyDetail.textContent = '换个关键词，或从这些分类继续：';
          emptyReset.hidden = true;
        }
        pagination.hidden = matches.length === 0 || totalPages <= 1;
        renderPagination(totalPages);

        const currentCat = catLinks.find((link) => link.dataset.cat === state.cat);
        if (state.cat !== 'all' && currentCat) {
          activeCategory.hidden = false;
          activeCategory.innerHTML = '';
          const link = document.createElement('a');
          link.className = 'category-page-link';
          link.href = `/c/${state.cat}/`;
          link.textContent = `查看「${currentCat.dataset.name}」分类页 →`;
          activeCategory.appendChild(link);
        } else {
          activeCategory.hidden = true;
          activeCategory.textContent = '';
        }

        catLinks.forEach((link) => {
          link.classList.toggle('is-active', link.dataset.cat === state.cat);
        });
        authButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.auth === state.auth));
        });
        quotaButton.setAttribute('aria-pressed', String(state.lim));
      }

      function update(resetPage = true) {
        if (resetPage) state.page = 1;
        render();
        syncUrl(false);
      }

      function scrollToList() {
        list.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      searchInput.addEventListener('input', () => {
        state.q = searchInput.value;
        update(true);
      });

      authButtons.forEach((button) => {
        button.addEventListener('click', () => {
          state.auth = button.dataset.auth;
          update(true);
        });
      });

      quotaButton.addEventListener('click', () => {
        state.lim = !state.lim;
        update(true);
      });

      emptyReset.addEventListener('click', () => {
        if (state.cat !== 'all' && state.auth === 'all' && !state.lim) {
          state.cat = 'all';
        } else {
          state.q = '';
          state.auth = 'all';
          state.lim = false;
          state.cat = 'all';
          searchInput.value = '';
        }
        update(true);
        scrollToList();
      });

      catLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          state.cat = link.dataset.cat;
          update(true);
          if (window.matchMedia('(max-width: 900px)').matches) scrollToList();
        });
      });

      pagination.addEventListener('click', (event) => {
        const link = event.target.closest('a[data-page]');
        if (!link) return;
        event.preventDefault();
        state.page = Number(link.dataset.page);
        render();
        syncUrl(true);
        scrollToList();
      });

      window.addEventListener('popstate', () => {
        readStateFromUrl();
        render();
      });

      function csvCell(value) {
        return `"${String(value).replace(/"/g, '""')}"`;
      }

      function freeTier(row) {
        return row.querySelector('.quota').lastChild.textContent.trim();
      }

      exportButton.addEventListener('click', () => {
        const header = ['名称', '说明', '认证', '免费额度', '状态', '链接'];
        const lines = matches.map((row) => {
          const nameLink = row.querySelector('.name');
          return [
            nameLink.textContent,
            row.querySelector('.desc').textContent,
            row.querySelector('.auth').textContent,
            freeTier(row),
            row.querySelector('.stamp').textContent,
            `${siteUrl}${nameLink.getAttribute('href')}`,
          ]
            .map(csvCell)
            .join(',');
        });
        const csv = `\uFEFF${[header.map(csvCell).join(','), ...lines].join('\r\n')}`;
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'free-apis.csv';
        document.body.appendChild(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      });

      readStateFromUrl();
      render();
    })();
  </script>
</Base>
