---
import Base from '../layouts/Base.astro';

const title = '免责声明 · 免费 API 中文索引';
const description = '免费 API 中文索引只做目录索引，不代理请求，不保证第三方 API 的可用性。';
---

<Base title={title} description={description} canonicalPath="/disclaimer/">
