---
import Base from '../layouts/Base.astro';
import { popularCategories } from '../lib/data.js';

const title = '页面不存在 · 免费 API 中文索引';
const description = '找不到这个页面。返回首页，或从热门分类继续浏览免费 API。';
const hotCategories = popularCategories(4);
---

<Base title={title} description={description} canonicalPath="/404.html" noindex>
  <div class="shell not-found">
    <p class="not-found-code">404</p>
    <h1>这个页面不存在</h1>
    <p>链接可能已经失效，或者地址写错了。可以回首页重新搜索。</p>
    <div class="popular-chips">
      <a href="/">返回首页</a>
      {hotCategories.map((category) => (
        <a href={`/c/${category.slug}/`}>{category.name}</a>
      ))}
    </div>
  </div>
</Base>
