---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { marked } from 'marked';
import {
  apis,
  authLabel,
  categoryCode,
  getCategory,
  limitSourceLabel,
  relatedApis,
  SITE_URL,
  statusOf,
} from '../../lib/data.js';

export function getStaticPaths() {
  return apis.map((api) => ({
    params: { slug: api.slug },
    props: {
      api,
      related: relatedApis(api, 4),
    },
  }));
}

const { api, related } = Astro.props;
const category = getCategory(api.category);
const status = statusOf(api);
const auth = authLabel(api);
const introHtml = marked.parse(api.intro, { async: false });
const intentTags = api.intent_tags ?? [];
const faq = api.faq ?? [];
const title = `${api.name} 免费额度、认证方式与调用示例 · 免费 API 中文索引`;
const description = `${api.name}：${api.plain_intro} ${api.free_tier}，${auth}。附 curl 示例与实测状态。`;
const canonicalPath = `/a/${api.slug}/`;
const officialHost = new URL(api.url).hostname;
const correctionUrl = `https://github.com/yukari09/public-apis/issues/new?title=[纠错]%20${api.slug}`;
const applicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: api.name,
  description: api.plain_intro,
  keywords: [...intentTags, ...(api.intent_queries ?? [])].join(', '),
  applicationCategory: category?.name ?? 'DeveloperApplication',
  operatingSystem: 'Any',
  url: `${SITE_URL}${canonicalPath}`,
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'CNY',
  },
};
const faqJsonLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;
const jsonLd = faqJsonLd ? [applicationJsonLd, faqJsonLd] : applicationJsonLd;
---

<Base title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <div class="shell detail-shell">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: category.name, href: `/c/${category.slug}/` },
        { label: api.name, href: canonicalPath },
      ]}
    />

    {api.status === 'dead' && (
      <div class="notice-banner" role="status">该接口疑似停止服务</div>
    )}

    <header class="detail-header">
      <h1>{api.name}</h1>
      <div class="detail-meta">
        <a
          class="detail-category"
          href={`/c/${category.slug}/`}
        >
          <span class="cat-dot"></span>
          {category.name}
          <span class="category-code">{categoryCode(category.slug)}</span>
        </a>
        <span class={`stamp ${status.cls}`}>{status.label}</span>
      </div>
      <p class="detail-desc">{api.description_zh}</p>
      <p class="detail-lead">{api.plain_intro}</p>
    </header>

    <div class="detail-body">
      <div class="detail-main">
        <section class="detail-section" aria-label="接口介绍">
          <div class="detail-intro" set:html={introHtml}></div>
          <p class="best-for"><span>适合：</span>{api.best_for}</p>
          {intentTags.length > 0 && (
            <ul class="intent-tags" aria-label="相关意图">
              {intentTags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </section>

        <section class="detail-section" aria-labelledby="info-title">
          <h2 id="info-title">基本信息</h2>
          <div class="spec-panel">
            <dl class="spec-grid">
              <div><dt>认证</dt><dd>{auth}</dd></div>
              <div><dt>免费额度</dt><dd>{api.free_tier}</dd></div>
              <div><dt>额度来源</dt><dd>{limitSourceLabel(api)}</dd></div>
              <div><dt>商用限制</dt><dd>{api.commercial?.trim() || '以官网为准'}</dd></div>
              <div>
                <dt>状态</dt>
                <dd><span class={`stamp ${status.cls}`}>{status.label}</span></dd>
              </div>
              <div><dt>最后检测时间</dt><dd>{api.checked_at}</dd></div>
              <div><dt>分类</dt><dd>{category.name}</dd></div>
            </dl>
          </div>
        </section>

        <section class="detail-section" aria-labelledby="capabilities-title">
          <h2 id="capabilities-title">能力</h2>
          <ul class="capability-list">
            {api.capabilities.map((capability) => (
              <li>{capability}</li>
            ))}
          </ul>
        </section>

        {faq.length > 0 && (
          <section class="detail-section" aria-labelledby="faq-title">
            <h2 id="faq-title">常见问题</h2>
            <dl class="faq-list">
              {faq.map((item) => (
                <div>
                  <dt>{item.q}</dt>
                  <dd>{item.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <div class="detail-actions">
          <a class="official-link" href={api.url} target="_blank" rel="noopener">访问官网</a>
          <a href={correctionUrl} target="_blank" rel="noopener">发现错误？提交纠错</a>
        </div>
      </div>

      <aside class="detail-aside">
        <section class="detail-section" aria-labelledby="example-title">
          <h2 id="example-title">调用示例</h2>
          <div class="code-wrap">
            <pre><code id="curl-example">{api.example}</code></pre>
            <button class="copy-btn" type="button" data-copy>复制</button>
          </div>
          <p class="hint">
            {api.auth === 'none' ? (
              <>该接口无需认证，可直接把示例粘进终端；使用前请阅读
                <a href={api.url} target="_blank" rel="noopener">官网说明</a>。
              </>
            ) : api.auth === 'api_key' ? (
              <>去 <a href={api.url} target="_blank" rel="noopener">{officialHost}</a> 注册拿 Key，替换示例里的 KEY。</>
            ) : (
              <>按 <a href={api.url} target="_blank" rel="noopener">{officialHost}</a> 的说明完成授权或认证，再替换示例中的占位值。</>
            )}
          </p>
        </section>

        <div class="detail-ad">
          <AdSlot />
        </div>
      </aside>
    </div>

    <section class="detail-section" aria-labelledby="related-title">
      <h2 id="related-title">参见</h2>
      <ul class="related-list">
        {related.map((item) => (
          <li>
            <a class="related-link" href={`/a/${item.slug}/`}>
              <span class="related-name">{item.name}</span>
              <span class="related-desc">{item.description_zh}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <script is:inline>
    (() => {
      'use strict';
      const button = document.querySelector('[data-copy]');
      const code = document.getElementById('curl-example');
      if (!button || !code) return;

      let timer;

      function reset() {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.textContent = '复制';
          button.classList.remove('is-copied');
        }, 2000);
      }

      function legacyCopy(text) {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        const ok = document.execCommand('copy');
        area.remove();
        return ok;
      }

      button.addEventListener('click', async () => {
        const text = code.textContent;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
          } else if (!legacyCopy(text)) {
            throw new Error('copy failed');
          }
          button.textContent = '已复制';
          button.classList.add('is-copied');
          reset();
        } catch {
          button.textContent = '复制失败';
          reset();
        }
      });
    })();
  </script>
</Base>
