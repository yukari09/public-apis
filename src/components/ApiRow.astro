---
import {
  authLabel,
  limitSourceLabel,
  statusOf,
} from '../lib/data.js';

const { api } = Astro.props;
const status = statusOf(api);
const auth = authLabel(api);
const href = `/a/${api.slug}/`;
---

<li
  class="entry"
  data-cat={api.category}
  data-auth={api.auth}
  data-k={api.tags.length ? api.tags.join(' ') : undefined}
>
  <a class="name" href={href}>{api.name}</a>
  <p class="desc">{api.description_zh}</p>
  <div class="entry-quota">
    <span class="quota">
      <span class="source">{limitSourceLabel(api)}</span>{api.free_tier}
    </span>
    <span class="auth">{auth}</span>
  </div>
  <span class={`stamp ${status.cls}`}>{status.label}</span>
</li>
